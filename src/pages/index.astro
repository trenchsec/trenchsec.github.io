---
import PageLayout from '../components/Layout/PageLayout.astro';
import { getCollection } from 'astro:content';

// Latest writeups for the teaser (newest first, drafts hidden)
const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);
const fmt = (d: Date) => d.toISOString().slice(0, 10);
const strip = (s: string) => s.replace(/<[^>]+>/g, ' ').replace(/\s+/g, ' ').trim();

// Engagement log: newest first. Every line is a fact already on record.
const log = [
  { when: 'ongoing', tag: 'PENTEST',  what: 'HTB Academy · CPTS path',               detail: 'Penetration Tester track, module by module, with lab write-ups' },
  { when: 'ongoing', tag: 'AI',       what: 'HTB Academy · AI Red Teamer path',      detail: 'Prompt injection, model abuse and AI application testing' },
  { when: 'ongoing', tag: 'TOOLING',  what: 'Personal AI infrastructure',             detail: 'Agent tooling on Claude Code: recon, triage and reporting workflows' },
  { when: 'ongoing', tag: 'LABS',     what: 'Hack The Box Labs · PortSwigger Labs', detail: 'Hands-on machines and Web Security Academy labs' },
  { when: '2026-07', tag: 'DATA',     what: 'CRM data migration',                     detail: '~96,000 records moved with near-zero errors; rate limits treated as the spec' },
  { when: '2026',    tag: 'TRAINING', what: 'Arcanum Security (Jason Haddix) · cohorts', detail: 'Red Blue Purple AI · Attacking AI · The Bug Hunter\'s Methodology · IDORminator Broken Access Control' },
  { when: '2025',    tag: 'API',      what: 'APIsec University',                      detail: 'OWASP API Top 10 · API Security Fundamentals · API Authentication · MCP Security' },
  { when: '2025',    tag: 'WEB',      what: 'TCM Security · Practical Bug Bounty',    detail: 'Web application testing methodology' },
  { when: '2024',    tag: 'MOBILE',   what: 'TCM Security · PEH and Mobile App Pentesting', detail: 'Plus Mobile Hacking Lab Android Security Specialist' },
];

const contacts = [
  { label: 'linkedin', value: 'in/chloe-obermeyer', href: 'https://www.linkedin.com/in/chloe-obermeyer/' },
  { label: 'x',        value: '@cobermeyer11',     href: 'https://x.com/cobermeyer11' },
  { label: 'github',   value: 'chloe-obermeyer',   href: 'https://github.com/chloe-obermeyer' },
];
---

<PageLayout title="Chloe Obermeyer" description="Trench Security: offensive security, OSINT due diligence and web and API security testing, South Africa.">
  <!-- ── $ whoami ─────────────────────────────────────────── -->
  <header class="hero" id="top">
    <div class="term" role="group" aria-label="Introduction">
      <div class="term-bar" aria-hidden="true">
        <span class="dot"></span><span class="dot"></span><span class="dot"></span>
        <span class="term-title">chloe@trench: ~</span>
      </div>
      <div class="term-body">
        <p class="line l1"><span class="ps1">chloe@trench</span>:<span class="path">~</span>$ <span class="cmd">whoami</span></p>
        <h1 class="who l2">Chloe Obermeyer</h1>
        <p class="out l2">Offensive security · OSINT · Research</p>
        <p class="line l3"><span class="ps1">chloe@trench</span>:<span class="path">~</span>$ <span class="cmd">cat services.txt</span></p>
        <ul class="services l4">
          <li><span class="tag">[OSINT]</span> Company due diligence and digital footprint audits</li>
          <li><span class="tag">[PENTEST]</span> Web and API security testing, CPTS in progress</li>
          <li><span class="tag">[RESEARCH]</span> Write-ups, tooling and methodology</li>
        </ul>
        <p class="line l5"><span class="ps1">chloe@trench</span>:<span class="path">~</span>$ <span class="cursor" aria-hidden="true"></span></p>
      </div>
    </div>

    <aside class="dossier" aria-label="Subject file">
      <div class="dossier-head"><span>FILE TS-001</span><span class="classified">CONFIDENTIAL</span></div>
      <div class="redacted-photo" aria-hidden="true"><span>[ REDACTED ]</span></div>
      <dl class="dossier-fields">
        <div><dt>SUBJECT</dt><dd><span class="redact">Chloe Obermeyer</span><span class="sr-only">identity withheld</span></dd></div>
        <div><dt>ROLE</dt><dd>Operator</dd></div>
        <div><dt>LOC</dt><dd>South Africa · SAST</dd></div>
        <div><dt>VIA</dt><dd><span class="trench-brand">Trench Security</span></dd></div>
        <div><dt>STATUS</dt><dd class="status"><span class="pulse" aria-hidden="true"></span>Available for contract</dd></div>
      </dl>
    </aside>
  </header>

  <!-- ── $ tail engagements.log ───────────────────────────── -->
  <section class="block" id="work" aria-labelledby="work-h">
    <h2 class="prompt" id="work-h"><span class="ps1">$</span> tail engagements.log</h2>
    <ol class="log">
      {log.map((e) => (
        <li class="entry">
          <span class="when">{e.when}</span>
          <span class="sev" data-tag={e.tag}>[{e.tag}]</span>
          <span class="what">{e.what}</span>
          <span class="detail">{e.detail}</span>
        </li>
      ))}
    </ol>
  </section>

  <!-- ── $ ls writeups/ ───────────────────────────────────── -->
  <section class="block" id="writeups" aria-labelledby="writeups-h">
    <h2 class="prompt" id="writeups-h"><span class="ps1">$</span> ls -t writeups/ <span class="hint">| head -3</span></h2>
    <div class="cards">
      {posts.map((p) => (
        <a class="card" href={`/blog/${p.slug}`}>
          <span class="card-meta"><span class="sev">[{p.data.category.toUpperCase()}]</span> {fmt(p.data.pubDate)}</span>
          <span class="card-title">{strip(p.data.title)}</span>
          <span class="card-desc">{p.data.description}</span>
          <span class="card-go">cat →</span>
        </a>
      ))}
    </div>
    <a class="more" href="/blog">cd ~/writeups <span aria-hidden="true">→</span></a>
  </section>

  <!-- ── $ cat contact.txt ────────────────────────────────── -->
  <section class="block" id="contact" aria-labelledby="contact-h">
    <h2 class="prompt" id="contact-h"><span class="ps1">$</span> cat contact.txt</h2>
    <div class="contact">
      <p class="contact-lead">Open to OSINT due diligence and web and API security work. Reach out on any of these:</p>
      <dl class="channels">
        {contacts.map((c) => (
          <div>
            <dt>{c.label}</dt>
            <dd><a href={c.href} target="_blank" rel="noopener">{c.value}</a></dd>
          </div>
        ))}
      </dl>
    </div>
  </section>
</PageLayout>

<style>
  /* ── Hero: terminal + dossier ─────────────────────────────── */
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr);
    gap: var(--space-lg);
    align-items: stretch;
  }

  .term, .dossier, .entry, .card, .contact {
    background: var(--op-surface);
    border: 1px solid var(--op-border);
    border-radius: 6px;
  }
  .term, .dossier { font-family: var(--font-mono); }
  .term { box-shadow: 0 0 0 1px rgba(74, 222, 128, 0.06), 0 20px 50px rgba(0, 0, 0, 0.45); }

  .term-bar { display: flex; align-items: center; gap: 6px; padding: 10px 14px; border-bottom: 1px solid var(--op-border); }
  .dot { width: 10px; height: 10px; border-radius: 50%; background: var(--op-border); }
  .term-title { margin-left: 10px; font-size: 0.75rem; color: var(--op-muted); }

  .term-body { padding: 22px 24px 26px; font-size: 0.95rem; line-height: 1.7; color: var(--op-text); }
  .line { margin: 0; color: var(--op-muted); }
  .ps1 { color: var(--op-green); }
  .path { color: var(--op-blue); }
  .cmd { color: var(--op-text); }

  .who {
    font-family: var(--font-sans);
    font-size: clamp(2rem, 5vw, 3.1rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.1;
    margin: 6px 0 2px;
    color: var(--op-text);
  }
  .out { margin: 0 0 18px; color: var(--op-muted); }

  .services { list-style: none; margin: 4px 0 18px; padding: 0; display: grid; gap: 6px; }
  .services li { color: var(--op-text); }
  .tag { color: var(--op-green); margin-right: 6px; }

  .cursor { display: inline-block; width: 0.6em; height: 1.1em; vertical-align: text-bottom; background: var(--op-green); animation: blink 1.1s steps(1) infinite; }
  @keyframes blink { 50% { opacity: 0; } }

  .l1, .l2, .l3, .l4, .l5 { opacity: 0; animation: reveal 0.35s ease forwards; }
  .l1 { animation-delay: 0.1s; }
  .l2 { animation-delay: 0.55s; }
  .l3 { animation-delay: 1.0s; }
  .l4 { animation-delay: 1.4s; }
  .l5 { animation-delay: 1.8s; }
  @keyframes reveal { from { opacity: 0; transform: translateY(3px); } to { opacity: 1; transform: none; } }

  .dossier { padding: 16px; display: flex; flex-direction: column; gap: 14px; }
  .dossier-head { display: flex; justify-content: space-between; font-size: 0.72rem; letter-spacing: 0.12em; color: var(--op-muted); }
  .classified { color: var(--op-red); }
  .redacted-photo {
    aspect-ratio: 4 / 3;
    border: 1px dashed var(--op-border);
    border-radius: 4px;
    display: grid;
    place-items: center;
    background: repeating-linear-gradient(135deg, rgba(248, 113, 113, 0.05) 0 8px, transparent 8px 16px), var(--op-bg);
  }
  .redacted-photo span { color: var(--op-red); font-size: 0.85rem; letter-spacing: 0.2em; }
  .dossier-fields { margin: 0; display: grid; gap: 8px; font-size: 0.82rem; }
  .dossier-fields div { display: grid; grid-template-columns: 72px 1fr; gap: 8px; }
  .dossier-fields dt { color: var(--op-muted); letter-spacing: 0.08em; }
  .dossier-fields dd { margin: 0; color: var(--op-text); }
  .redact { background: var(--op-text); color: transparent; border-radius: 2px; user-select: none; padding: 0 2px; }
  .sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
  .status { color: var(--op-green); display: flex; align-items: center; gap: 8px; }
  .pulse { width: 8px; height: 8px; border-radius: 50%; background: var(--op-green); box-shadow: 0 0 0 0 rgba(74, 222, 128, 0.6); animation: pulse 2s infinite; }
  @keyframes pulse { 70% { box-shadow: 0 0 0 7px rgba(74, 222, 128, 0); } 100% { box-shadow: 0 0 0 0 rgba(74, 222, 128, 0); } }

  .trench-brand {
    font-weight: 600;
    background-image: linear-gradient(135deg, #a78bfa, #3B82F6, #22C55E);
    background-clip: text;
    -webkit-background-clip: text;
    color: transparent;
  }

  /* ── Sections ─────────────────────────────────────────────── */
  .block { margin-top: 4.5rem; scroll-margin-top: 90px; }
  .prompt {
    font-family: var(--font-mono);
    font-size: 1.05rem;
    font-weight: 500;
    color: var(--op-text);
    margin: 0 0 1rem;
    padding-bottom: 0.6rem;
    border-bottom: 1px solid var(--op-border);
  }
  .hint { color: var(--op-muted); }
  .sev { font-family: var(--font-mono); color: var(--op-green); }

  /* engagement log */
  .log { list-style: none; margin: 0; padding: 0; display: grid; gap: 8px; }
  .entry {
    display: grid;
    grid-template-columns: 84px 108px minmax(0, 1fr);
    grid-template-areas: "when sev what" "when sev detail";
    column-gap: 14px;
    row-gap: 2px;
    padding: 12px 16px;
    border-left: 2px solid var(--op-green);
    transition: border-color var(--transition-fast), background var(--transition-fast);
  }
  .entry:hover { border-left-color: var(--op-blue); background: #141722; }
  .when { grid-area: when; font-family: var(--font-mono); font-size: 0.82rem; color: var(--op-muted); padding-top: 2px; }
  .entry .sev { grid-area: sev; font-size: 0.82rem; padding-top: 2px; }
  .what { grid-area: what; color: var(--op-text); font-weight: 600; }
  .detail { grid-area: detail; color: var(--op-muted); font-size: 0.92rem; }

  /* writeups */
  .cards { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 12px; }
  .card { display: flex; flex-direction: column; gap: 8px; padding: 18px; text-decoration: none; transition: border-color var(--transition-fast); }
  .card:hover { border-color: var(--op-green); }
  .card-meta { font-family: var(--font-mono); font-size: 0.78rem; color: var(--op-muted); }
  .card-title { color: var(--op-text); font-weight: 600; font-size: 1.05rem; line-height: 1.35; }
  .card-desc { color: var(--op-muted); font-size: 0.92rem; }
  .card-go { margin-top: auto; font-family: var(--font-mono); font-size: 0.8rem; color: var(--op-blue); }
  .more { display: inline-block; margin-top: 14px; font-family: var(--font-mono); font-size: 0.9rem; color: var(--op-blue); text-decoration: none; }
  .more:hover { text-decoration: underline; }

  /* contact */
  .contact { padding: 20px 22px; font-family: var(--font-mono); }
  .contact-lead { margin: 0 0 14px; color: var(--op-muted); font-size: 0.92rem; }
  .channels { margin: 0; display: grid; gap: 8px; }
  .channels div { display: grid; grid-template-columns: 96px 1fr; gap: 10px; }
  .channels dt { color: var(--op-green); }
  .channels dt::after { content: ':'; }
  .channels dd { margin: 0; }
  .channels a { color: var(--op-blue); text-decoration: none; }
  .channels a:hover { text-decoration: underline; }

  @media (prefers-reduced-motion: reduce) {
    .l1, .l2, .l3, .l4, .l5 { opacity: 1; animation: none; }
    .cursor, .pulse { animation: none; }
  }

  @media (max-width: 860px) {
    .hero { grid-template-columns: 1fr; }
    .redacted-photo { aspect-ratio: 16 / 7; }
  }

  @media (max-width: 600px) {
    .entry { grid-template-columns: auto 1fr; grid-template-areas: "when sev" "what what" "detail detail"; column-gap: 10px; }
    .term-body { padding: 18px 16px 20px; font-size: 0.88rem; }
    .block { margin-top: 3rem; }
  }
</style>
