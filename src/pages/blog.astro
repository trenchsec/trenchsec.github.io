---
import PageLayout from '../components/Layout/PageLayout.astro';
import { getCollection } from 'astro:content';

// All non-draft posts, newest first
const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const strip = (s: string) => s.replace(/<[^>]+>/g, ' ').replace(/\s+/g, ' ').trim();
const rows = posts.map((p) => ({
  slug: p.slug,
  date: p.data.pubDate.toISOString().slice(0, 10),
  cat: p.data.category,
  title: strip(p.data.title),
  desc: p.data.description,
  mins: Math.max(1, Math.round(p.body.split(/\s+/).filter(Boolean).length / 220)),
}));

// Only offer filters for categories that actually have posts
const cats = [...new Set(rows.map((r) => r.cat))];
---

<PageLayout title="Writeups" description="Writeups, tutorials and research from Trench Security: OSINT, web and API security, and offensive security practice.">
  <section class="dir">
    <h1 class="prompt"><span class="ps1">chloe@trench</span>:<span class="path">~/writeups</span>$ ls -la</h1>
    <p class="sub">Writeups, tutorials and notes from the trenches. {rows.length} {rows.length === 1 ? 'file' : 'files'}.</p>

    {cats.length > 1 && (
      <div class="filters" role="group" aria-label="Filter by category">
        <button class="flt active" data-cat="all" type="button">--all</button>
        {cats.map((c) => <button class="flt" data-cat={c} type="button">--tag={c}</button>)}
      </div>
    )}

    <ol class="listing">
      <li class="head" aria-hidden="true">
        <span>date</span><span>tag</span><span>name</span><span class="r">read</span>
      </li>
      {rows.map((r) => (
        <li class="row" data-cat={r.cat}>
          <a href={`/blog/${r.slug}`}>
            <span class="date">{r.date}</span>
            <span class="sev">[{r.cat.toUpperCase()}]</span>
            <span class="name">
              <span class="file">{r.slug}.md</span>
              <span class="ttl">{r.title}</span>
              <span class="desc">{r.desc}</span>
            </span>
            <span class="mins r">{r.mins} min</span>
          </a>
        </li>
      ))}
    </ol>

    {rows.length === 0 && <p class="sub">No files yet. Writeups are on the way.</p>}
    <a class="home" href="/">cd ~</a>
  </section>
</PageLayout>

<style>
  .dir { max-width: 960px; margin: 0 auto; }
  .prompt { font-family: var(--font-mono); font-size: clamp(1rem, 2.4vw, 1.3rem); font-weight: 500; color: var(--op-text); margin: 0 0 8px; word-break: break-word; }
  .ps1, .sev { color: var(--op-green); font-family: var(--font-mono); }
  .path { color: var(--op-blue); }
  .sub { color: var(--op-muted); font-family: var(--font-mono); font-size: 0.85rem; margin: 0 0 1.5rem; }

  .filters { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 1.25rem; }
  .flt { font-family: var(--font-mono); font-size: 0.8rem; color: var(--op-muted); background: var(--op-surface); border: 1px solid var(--op-border); border-radius: 4px; padding: 4px 10px; cursor: pointer; }
  .flt:hover, .flt.active { color: var(--op-green); border-color: var(--op-green); }

  .listing { list-style: none; margin: 0; padding: 0; border: 1px solid var(--op-border); border-radius: 6px; overflow: hidden; background: var(--op-surface); }
  .head, .row a { display: grid; grid-template-columns: 104px 120px minmax(0, 1fr) 64px; gap: 14px; padding: 12px 16px; }
  .head { font-family: var(--font-mono); font-size: 0.72rem; letter-spacing: 0.1em; color: var(--op-muted); text-transform: uppercase; border-bottom: 1px solid var(--op-border); }
  .row + .row { border-top: 1px solid var(--op-border); }
  .row a { text-decoration: none; align-items: start; transition: background var(--transition-fast); }
  .row a:hover { background: #141722; }
  .row a:hover .file { color: var(--op-green); }
  .date, .mins { font-family: var(--font-mono); font-size: 0.82rem; color: var(--op-muted); padding-top: 2px; }
  .row .sev { font-size: 0.82rem; padding-top: 2px; }
  .name { display: grid; gap: 3px; }
  .file { font-family: var(--font-mono); font-size: 0.82rem; color: var(--op-blue); }
  .ttl { color: var(--op-text); font-weight: 600; }
  .desc { color: var(--op-muted); font-size: 0.92rem; }
  .r { text-align: right; }
  .row.hidden { display: none; }

  .home { display: inline-block; margin-top: 1.25rem; font-family: var(--font-mono); font-size: 0.85rem; color: var(--op-blue); text-decoration: none; }
  .home::before { content: '$ '; color: var(--op-green); }

  @media (max-width: 640px) {
    .head { display: none; }
    .row a { grid-template-columns: auto 1fr auto; grid-template-areas: "date sev mins" "name name name"; row-gap: 6px; }
    .date { grid-area: date; } .row .sev { grid-area: sev; } .mins { grid-area: mins; } .name { grid-area: name; }
  }
</style>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('.flt');
  const rows = document.querySelectorAll<HTMLElement>('.row');
  buttons.forEach((b) =>
    b.addEventListener('click', () => {
      buttons.forEach((x) => x.classList.remove('active'));
      b.classList.add('active');
      const cat = b.dataset.cat;
      rows.forEach((r) => r.classList.toggle('hidden', cat !== 'all' && r.dataset.cat !== cat));
    })
  );
</script>
