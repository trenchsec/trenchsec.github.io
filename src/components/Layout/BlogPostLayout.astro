---
import PageLayout from './PageLayout.astro';

interface Link { slug: string; title: string }
interface Props {
  slug: string;
  title: string;
  description: string;
  pubDate: Date;
  author: string;
  tags: string[];
  category: string;
  readMins: number;
  newer: Link | null;
  older: Link | null;
}

const { slug, title, description, pubDate, author, tags, category, readMins, newer, older } = Astro.props;
const strip = (s: string) => s.replace(/<[^>]+>/g, ' ').replace(/\s+/g, ' ').trim();
const plainTitle = strip(title);
const isoDate = pubDate.toISOString().slice(0, 10);
---

<PageLayout title={plainTitle} description={description}>
  <article class="post" data-title={plainTitle}>
    <a href="/blog" class="back">cd ~/writeups</a>

    <header class="post-head">
      <p class="cat-line"><span class="ps1">$</span> cat {slug}.md</p>
      <dl class="front">
        <div><dt>date</dt><dd><time datetime={isoDate}>{isoDate}</time></dd></div>
        <div><dt>category</dt><dd class="sev">[{category.toUpperCase()}]</dd></div>
        <div><dt>tags</dt><dd>{tags.join(' · ')}</dd></div>
        <div><dt>read</dt><dd>{readMins} min</dd></div>
        <div><dt>author</dt><dd>{author}</dd></div>
      </dl>
      <h1 class="title" set:html={title} />
      <p class="lede">{description}</p>
    </header>

    <div class="post-content">
      <slot />
    </div>

    <footer class="post-end">
      <p class="eof">EOF</p>
      <nav class="pager" aria-label="More writeups">
        {newer ? <a class="pg" href={`/blog/${newer.slug}`}><span class="pg-dir">← newer</span><span class="pg-t">{strip(newer.title)}</span></a> : <span></span>}
        {older ? <a class="pg pg-r" href={`/blog/${older.slug}`}><span class="pg-dir">older →</span><span class="pg-t">{strip(older.title)}</span></a> : <span></span>}
      </nav>
      <a href="/blog" class="back">cd ~/writeups</a>
    </footer>
  </article>
</PageLayout>

<style>
  .post { max-width: 72ch; margin: 0 auto; }

  .back { font-family: var(--font-mono); font-size: 0.85rem; color: var(--op-blue); text-decoration: none; }
  .back::before { content: '$ '; color: var(--op-green); }
  .back:hover { text-decoration: underline; }

  .post-head { margin: 1.5rem 0 2.5rem; padding-bottom: 1.5rem; border-bottom: 1px solid var(--op-border); }
  .cat-line { font-family: var(--font-mono); color: var(--op-text); margin: 0 0 12px; }
  .ps1, .sev { color: var(--op-green); font-family: var(--font-mono); }
  .front {
    margin: 0 0 1.5rem;
    padding: 12px 16px;
    background: var(--op-surface);
    border: 1px solid var(--op-border);
    border-left: 2px solid var(--op-green);
    border-radius: 6px;
    font-family: var(--font-mono);
    font-size: 0.82rem;
    display: grid;
    gap: 4px;
  }
  .front div { display: grid; grid-template-columns: 84px 1fr; gap: 10px; }
  .front dt { color: var(--op-muted); }
  .front dt::after { content: ':'; }
  .front dd { margin: 0; color: var(--op-text); }
  .title { font-size: clamp(1.8rem, 4.5vw, 2.6rem); font-weight: 700; line-height: 1.15; letter-spacing: -0.02em; color: var(--op-text); margin: 0 0 12px; }
  .lede { color: var(--op-muted); font-size: 1.1rem; line-height: 1.6; margin: 0; }

  /* ── Reading ───────────────────────────────────────────── */
  .post-content { color: var(--op-text); font-size: 1.06rem; line-height: 1.8; }
  .post-content :global(p) { margin: 0 0 1.25rem; color: var(--op-text); max-width: none; }
  .post-content :global(h1), .post-content :global(h2), .post-content :global(h3) { color: var(--op-text); line-height: 1.25; margin: 2.5rem 0 1rem; }
  .post-content :global(h2) { font-size: 1.5rem; }
  .post-content :global(h2)::before { content: '## '; color: var(--op-green); font-family: var(--font-mono); font-size: 0.85em; }
  .post-content :global(h3) { font-size: 1.2rem; }
  .post-content :global(h1.dup) { display: none; }
  .post-content :global(a) { color: var(--op-blue); }
  .post-content :global(strong) { color: #fff; }
  .post-content :global(ul), .post-content :global(ol) { margin: 0 0 1.25rem 1.4rem; }
  .post-content :global(li) { margin-bottom: 0.4rem; }
  .post-content :global(img) { max-width: 100%; border: 1px solid var(--op-border); border-radius: 6px; margin: 1rem 0 1.5rem; }
  .post-content :global(hr) { border: 0; border-top: 1px dashed var(--op-border); margin: 2.5rem 0; }

  .post-content :global(blockquote) { margin: 1.5rem 0; padding: 4px 0 4px 18px; border-left: 2px solid var(--op-purple); color: var(--op-muted); font-style: italic; }

  /* [!] callouts, made from > [!NOTE] / [!TIP] / [!WARNING] blockquotes */
  .post-content :global(.callout) { font-style: normal; color: var(--op-text); background: var(--op-surface); border: 1px solid var(--op-border); border-left: 2px solid var(--op-blue); border-radius: 6px; padding: 12px 16px; }
  .post-content :global(.callout[data-kind="warning"]), .post-content :global(.callout[data-kind="caution"]) { border-left-color: var(--op-red); }
  .post-content :global(.callout[data-kind="tip"]) { border-left-color: var(--op-green); }
  .post-content :global(.callout-label) { display: block; font-family: var(--font-mono); font-size: 0.8rem; color: var(--op-blue); margin-bottom: 4px; }
  .post-content :global(.callout[data-kind="warning"] .callout-label), .post-content :global(.callout[data-kind="caution"] .callout-label) { color: var(--op-red); }
  .post-content :global(.callout[data-kind="tip"] .callout-label) { color: var(--op-green); }

  /* inline code */
  .post-content :global(:not(pre) > code) { font-family: var(--font-mono); font-size: 0.88em; background: var(--op-surface); border: 1px solid var(--op-border); border-radius: 4px; padding: 1px 6px; color: var(--op-green); }

  /* code blocks as terminal windows */
  .post-content :global(.termblock) { margin: 1.5rem 0; border: 1px solid var(--op-border); border-radius: 6px; overflow: hidden; background: #0d0f15; }
  .post-content :global(.termblock-bar) { display: flex; justify-content: space-between; align-items: center; padding: 6px 12px; border-bottom: 1px solid var(--op-border); font-family: var(--font-mono); font-size: 0.75rem; color: var(--op-muted); background: var(--op-surface); }
  .post-content :global(.termblock-copy) { background: none; border: 1px solid var(--op-border); border-radius: 4px; color: var(--op-muted); font-family: var(--font-mono); font-size: 0.72rem; padding: 2px 8px; cursor: pointer; }
  .post-content :global(.termblock-copy:hover) { color: var(--op-green); border-color: var(--op-green); }
  .post-content :global(pre) { margin: 0; padding: 14px 16px; overflow-x: auto; font-family: var(--font-mono); font-size: 0.88rem; line-height: 1.6; background: transparent !important; }

  /* Chloe's signature divider: // { φ ||-// ◇ △▲△ ∞ ◇ //-|| φ } // */
  .post-content :global(p.divider) { text-align: center; color: var(--op-purple); font-family: var(--font-mono); font-size: 0.9rem; margin: 2.5rem 0; letter-spacing: 0.05em; }

  /* ── End of file ───────────────────────────────────────── */
  .post-end { margin-top: 3rem; padding-top: 1.5rem; border-top: 1px solid var(--op-border); display: grid; gap: 1.25rem; }
  .eof { font-family: var(--font-mono); color: var(--op-muted); margin: 0; letter-spacing: 0.2em; }
  .pager { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
  .pg { display: grid; gap: 4px; padding: 12px 14px; background: var(--op-surface); border: 1px solid var(--op-border); border-radius: 6px; text-decoration: none; }
  .pg:hover { border-color: var(--op-green); }
  .pg-r { text-align: right; }
  .pg-dir { font-family: var(--font-mono); font-size: 0.75rem; color: var(--op-muted); }
  .pg-t { color: var(--op-text); font-size: 0.92rem; }

  @media (max-width: 600px) {
    .pager { grid-template-columns: 1fr; }
    .post-content { font-size: 1rem; }
  }
</style>

<script>
  const content = document.querySelector('.post-content');
  const post = document.querySelector('.post') as HTMLElement | null;
  if (content && post) {
    // Hide a leading markdown H1 that repeats the page title (the header already shows it)
    const first = content.querySelector('h1');
    const title = (post.dataset.title || '').toLowerCase();
    if (first && title.includes((first.textContent || '').trim().toLowerCase())) first.classList.add('dup');

    // Signature dividers
    content.querySelectorAll('p').forEach((p) => {
      if (p.textContent?.includes('φ')) p.classList.add('divider');
    });

    // > [!NOTE] style blockquotes become [!] callouts
    content.querySelectorAll('blockquote').forEach((bq) => {
      const p = bq.querySelector('p');
      const m = p?.innerHTML.match(/^\s*\[!(NOTE|TIP|WARNING|CAUTION|IMPORTANT)\]\s*(<br>)?/i);
      if (!p || !m) return;
      const kind = m[1].toLowerCase();
      p.innerHTML = p.innerHTML.slice(m[0].length);
      bq.classList.add('callout');
      bq.dataset.kind = kind;
      const label = document.createElement('span');
      label.className = 'callout-label';
      label.textContent = `[!] ${kind.toUpperCase()}`;
      bq.prepend(label);
    });

    // Code blocks become terminal windows with a copy button
    content.querySelectorAll('pre').forEach((pre) => {
      const wrap = document.createElement('div');
      wrap.className = 'termblock';
      const bar = document.createElement('div');
      bar.className = 'termblock-bar';
      const lang = pre.getAttribute('data-language') || 'shell';
      const name = document.createElement('span');
      name.textContent = lang;
      const btn = document.createElement('button');
      btn.className = 'termblock-copy';
      btn.type = 'button';
      btn.textContent = 'copy';
      btn.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(pre.innerText);
          btn.textContent = 'copied';
        } catch {
          btn.textContent = 'select + ctrl-c';
        }
        setTimeout(() => (btn.textContent = 'copy'), 1500);
      });
      bar.append(name, btn);
      pre.replaceWith(wrap);
      wrap.append(bar, pre);
    });
  }
</script>
